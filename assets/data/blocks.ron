// Loudstone block table.
//
// This file IS the block list. `src/block.rs` reads it; nothing else defines a
// block. The copy compiled into the binary lives here, and a copy dropped next
// to the executable (or in ./assets/data) overrides it at startup, so a
// designer can retune the whole world without a compiler.
//
// ---------------------------------------------------------------------------
// IDS ARE FROZEN. Save files on disk store raw block numbers and the texture
// atlas maps numbers to tiles. Never change an existing `id`, never reuse a
// retired one -- append new blocks at the end with the next free number.
// ---------------------------------------------------------------------------
//
// Fields, and what they default to when left out:
//
//   id            u8, required, unique. Frozen forever once shipped.
//   name          unique lowercase key. Recipes and drops refer to blocks by
//                 this, never by number.
//   color         [r, g, b] in 0..1. A tint over the texture, and the flat
//                 colour the HUD, map and item icons use.
//   hardness      relative mining cost, higher is slower. `inf` is unbreakable.
//   opaque        true   hides the neighbouring face, and stops light dead.
//   solid         true   the player collides with it.
//   replaceable   false  placing a block here just overwrites it (air, water,
//                        small plants).
//   render        Solid  one of Solid | Cutout | Cross | Post | Water.
//   light         0      block light this emits, 0..=15.
//   light_opacity None   light eaten per block; defaults from `opaque`
//                        (15) / the "leaves" tag (1) / else 0.
//   tags          []     any of "grassy", "log", "leaves".
//   tool          None   the tool kind that mines it faster: Pickaxe|Axe|Sword.
//   requires      Hands  Hands | Tier("<tier name from items.ron>") | Never.
//                        A Tier gate also demands the matching `tool` kind.
//   drops         Itself Itself | Nothing | Item("<item name>").
//
// Adding a block: append an entry here, give it a texture in `texture.rs`, and
// (if the player should be able to carry it) add an item in `items.ron` whose
// id is the same number.

(
    blocks: [
        // --- frozen core, ids 0..=17 -----------------------------------------

        // Never drawn. Magenta so a leak into the renderer is obvious.
        (id:  0, name: "air",            color: [1.00, 0.00, 1.00], hardness: 1.0,
            opaque: false, solid: false, replaceable: true, requires: Never, drops: Nothing),

        (id:  1, name: "stone",          color: [0.50, 0.50, 0.53], hardness: 1.5,
            tool: Pickaxe, requires: Tier("wood"), drops: Item("cobblestone")),

        (id:  2, name: "dirt",           color: [0.42, 0.30, 0.19], hardness: 0.6),

        (id:  3, name: "grass",          color: [0.32, 0.58, 0.24], hardness: 0.6,
            tags: ["grassy"], drops: Item("dirt")),

        (id:  4, name: "sand",           color: [0.83, 0.78, 0.55], hardness: 0.6),

        (id:  5, name: "wood",           color: [0.38, 0.27, 0.16], hardness: 2.0,
            tags: ["log"], tool: Axe),

        // Leaves are solid enough to stand on but never cull the face behind
        // them, and shear fastest with a sword. They drop nothing.
        (id:  6, name: "leaves",         color: [0.20, 0.45, 0.18], hardness: 0.2,
            opaque: false, render: Cutout, tags: ["leaves"], tool: Sword, drops: Nothing),

        (id:  7, name: "planks",         color: [0.63, 0.48, 0.29], hardness: 2.0,
            tool: Axe),

        (id:  8, name: "cobblestone",    color: [0.42, 0.42, 0.44], hardness: 1.5,
            tool: Pickaxe, requires: Tier("wood")),

        (id:  9, name: "coal_ore",       color: [0.24, 0.24, 0.26], hardness: 3.0,
            tool: Pickaxe, requires: Tier("wood"), drops: Item("coal")),

        (id: 10, name: "iron_ore",       color: [0.71, 0.57, 0.45], hardness: 3.0,
            tool: Pickaxe, requires: Tier("stone"), drops: Item("raw_iron")),

        (id: 11, name: "gold_ore",       color: [0.85, 0.72, 0.24], hardness: 3.5,
            tool: Pickaxe, requires: Tier("iron")),

        (id: 12, name: "diamond_ore",    color: [0.36, 0.80, 0.82], hardness: 3.5,
            tool: Pickaxe, requires: Tier("iron")),

        (id: 13, name: "bedrock",        color: [0.15, 0.15, 0.17], hardness: inf,
            requires: Never, drops: Nothing),

        (id: 14, name: "water",          color: [0.20, 0.40, 0.75], hardness: 1.0,
            opaque: false, solid: false, replaceable: true, render: Water,
            light_opacity: Some(3), requires: Never, drops: Nothing),

        (id: 15, name: "torch",          color: [0.95, 0.78, 0.35], hardness: 0.1,
            opaque: false, solid: false, render: Post, light: 14),

        (id: 16, name: "crafting_table", color: [0.55, 0.40, 0.24], hardness: 2.5,
            tool: Axe),

        (id: 17, name: "furnace",        color: [0.38, 0.38, 0.40], hardness: 3.5,
            tool: Pickaxe, requires: Tier("wood")),

        // --- worldgen blocks, appended from 18 -------------------------------

        (id: 18, name: "sandstone",      color: [0.76, 0.70, 0.49], hardness: 0.9),
        (id: 19, name: "gravel",         color: [0.48, 0.46, 0.45], hardness: 0.6),
        (id: 20, name: "clay",           color: [0.61, 0.63, 0.67], hardness: 0.6),
        (id: 21, name: "snow",           color: [0.93, 0.95, 0.98], hardness: 0.15),
        // Opaque on purpose: with flat colours a see-through ice cube looks
        // identical to a solid one and costs six extra faces.
        (id: 22, name: "ice",            color: [0.63, 0.79, 0.93], hardness: 0.5),
        (id: 23, name: "granite",        color: [0.60, 0.44, 0.38], hardness: 1.5),
        (id: 24, name: "diorite",        color: [0.73, 0.73, 0.71], hardness: 1.5),
        (id: 25, name: "andesite",       color: [0.55, 0.57, 0.55], hardness: 1.5),

        (id: 26, name: "birch_log",      color: [0.82, 0.80, 0.72], hardness: 2.0,
            tags: ["log"]),
        (id: 27, name: "birch_leaves",   color: [0.44, 0.61, 0.26], hardness: 0.2,
            opaque: false, render: Cutout, tags: ["leaves"]),
        (id: 28, name: "spruce_log",     color: [0.27, 0.19, 0.12], hardness: 2.0,
            tags: ["log"]),
        (id: 29, name: "spruce_leaves",  color: [0.15, 0.32, 0.20], hardness: 0.2,
            opaque: false, render: Cutout, tags: ["leaves"]),

        (id: 30, name: "cactus",         color: [0.27, 0.51, 0.23], hardness: 0.4),

        // Ground cover: two crossed quads, walked straight through, and
        // overwritten by anything the player places.
        (id: 31, name: "tall_grass",     color: [0.38, 0.63, 0.25], hardness: 0.1,
            opaque: false, solid: false, replaceable: true, render: Cross),
        (id: 32, name: "flower_red",     color: [0.68, 0.31, 0.28], hardness: 0.1,
            opaque: false, solid: false, replaceable: true, render: Cross),
        (id: 33, name: "flower_yellow",  color: [0.80, 0.75, 0.32], hardness: 0.1,
            opaque: false, solid: false, replaceable: true, render: Cross),
        (id: 34, name: "dead_bush",      color: [0.55, 0.44, 0.25], hardness: 0.1,
            opaque: false, solid: false, replaceable: true, render: Cross),

        // Biome tints. The mesher carries one flat colour per id, so a tint is
        // spelled as its own block rather than as per-vertex colour.
        (id: 35, name: "grass_cold",     color: [0.36, 0.52, 0.36], hardness: 0.6,
            tags: ["grassy"]),
        (id: 36, name: "grass_dry",      color: [0.60, 0.62, 0.31], hardness: 0.6,
            tags: ["grassy"]),
        (id: 37, name: "grass_swamp",    color: [0.29, 0.42, 0.22], hardness: 0.6,
            tags: ["grassy"]),
        (id: 38, name: "podzol",         color: [0.35, 0.24, 0.12], hardness: 0.6,
            tags: ["grassy"]),
    ],
)
